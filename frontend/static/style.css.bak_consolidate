/* ===========================
   GEOSHIELD OS V3
=========================== */
:root{

--bg:#0b1220;
--panel:#111827;
--card:#1f2937;
--border:#263449;

--primary:#2563eb;

--text:#ffffff;
--muted:#94a3b8;

--radius:12px;

}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:"Segoe UI",sans-serif;
}

body{
    background:#0b1220;
    color:#fff;
    overflow:hidden;
}

.app{
    display:grid;
    grid-template-columns:180px 1fr;
    height:100vh;
}

/* ===========================
LEFT SIDEBAR
=========================== */

.sidebar{
    background:#0f172a;
    border-right:1px solid #1f2937;
    display:flex;
    flex-direction:column;
}

.logo{
    padding:14px 10px;
    border-bottom:1px solid #1f2937;
    text-align:center;
}

.logo h2{
    font-size:18px;
    font-weight:700;
}

.logo span{
    color:#94a3b8;
    font-size:11px;
    line-height:1.4;
    display:block;
    margin-top:10px;
}

.sidebar nav{
    padding:16px 12px;
    display:flex;
    flex-direction:column;
    gap:5px;
    flex:1;
    overflow-y:auto;
}

.sidebar a{
    color:#d1d5db;
    text-decoration:none;
    padding: 12px 14px;
    font-size:15px;
    border-radius:10px;
    transition:.25s;
}

.sidebar a:hover{
    background:#1e293b;
}

.sidebar .active{
    background:#2563eb;
    color:white;
}

.sidebar hr{
    border:none;
    border-top:1px solid #263449;
    margin:10px 0;
}

/* ===========================
RIGHT SIDE
=========================== */

.main-content{
    display:grid;
    grid-template-rows:60px 1fr 110px;
    height:100vh;
    overflow:hidden;
}

/* ===========================
TOP BAR
=========================== */

.topbar{
    background:#172136;
    border-bottom:1px solid #263449;

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:0 20px;
}

.title h1{
    font-size:22px;
}

.title span{
    font-size:13px;
    color:#94a3b8;
}
.top-actions{
    display:flex;
    align-items:center;
    gap:10px;
}
.top-actions button{
    background:#1e293b;
    color:white;
    border:none;
    padding:9px 16px;
    border-radius:10px;
    font-size:13px;
    min-width:90px;
    white-space:nowrap;
    cursor:pointer;
    transition:.25s;
}

.top-actions button:hover{
    background:#2563eb;
}

/* ===========================
CENTER
=========================== */

.workspace{
    display:grid;
    grid-template-columns:minmax(0,1fr) 280px;
    gap:12px;
    padding:8px;
    overflow:hidden;
}
/* MAP */

.map-section{
    height:100%;
    padding:0;
   }

#map{
    width:100%;
    height:100%;
    border-radius:14px;
    overflow:hidden;
}
/* RIGHT PANEL */

.info-panel{
    background:#111827;
    border-left:1px solid #263449;
    padding:10px;
    overflow-y:auto;

    display:flex;
    flex-direction:column;
    gap:12px;
}

.panel-card{
    background:#1f2937;
    border-radius:12px;

    padding:12px 14px;

    display:flex;
    flex-direction:column;
    justify-content:center;

    min-height:78px;

    transition:.25s;

    box-shadow:0 2px 6px rgba(0,0,0,.18);

    overflow:hidden;
position:relative;

}

.panel-card h3{
    font-size:15px;
    font-weight:600;
    margin-bottom:8px;

    display:flex;
    align-items:center;
    gap:8px;
}

.panel-card p{
    font-size:12px;
    color:#d1d5db;
    line-height:1.5;
}

.panel-card h1{
    font-size:24px;
    font-weight:700;
    margin-top:2px;
}

.panel-card:hover{
    background:#273447;
    transform:translateY(-2px);
}
/* ===========================
BOTTOM
=========================== */

.bottom-dashboard{
    display:grid;
    grid-auto-flow:column;
    grid-auto-columns:150px;

    gap:10px;

    overflow-x:auto;
    overflow-y:hidden;

   padding:8px 10px;

    background:#111827;

    border-top:1px solid #263449;

    height:88px;

    align-items:center;
}

.bottom-card{
    background:#1f2937;

    border-radius:12px;

    padding:10px;

    display:flex;

    flex-direction:column;

    justify-content:space-between;

    height:62px;
}
.bottom-card h3{
    font-size:12px;
}

.bottom-dashboard::-webkit-scrollbar{
    height:6px;
}

.bottom-dashboard::-webkit-scrollbar-track{
    background:#111827;
}

.bottom-dashboard::-webkit-scrollbar-thumb{
    background:#2d3d58;
    border-radius:10px;
}

.bottom-dashboard::-webkit-scrollbar-thumb:hover{
    background:#3b82f6;
}

.pulse-fire{

animation:pulseFire 1.2s infinite;

}

@keyframes pulseFire{

0%{
transform:scale(1);
opacity:1;
filter:drop-shadow(0 0 2px red);
}

50%{
transform:scale(1.6);
opacity:.6;
filter:drop-shadow(0 0 12px orange);
}

100%{
transform:scale(1);
opacity:1;
filter:drop-shadow(0 0 2px red);
}

}

.legend{

background:#1f2937;

padding:12px;

border-radius:10px;

color:white;

font-size:13px;

line-height:22px;

border:1px solid #374151;

box-shadow:0 0 10px rgba(0,0,0,.5);

}
/* ============================================================
   GEOSHIELD COLLAPSIBLE WORKSPACE
   FINAL NAVIGATION OVERRIDE
   ============================================================ */

.workspace {
    display: block !important;
    height: auto !important;
    min-height: 0 !important;
    overflow: visible !important;
}

.map-section {
    display: block !important;
    width: 100% !important;
    height: 70vh !important;
    min-height: 520px !important;
    overflow: hidden !important;
}

#map {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    min-height: 520px !important;
}

#satelliteCenter[hidden] {
    display: none !important;
}

#satelliteCenter.workspace-intelligence-active {
    display: block !important;
    width: 100% !important;
    visibility: visible !important;
    opacity: 1 !important;
    height: auto !important;
    min-height: 0 !important;
    overflow: visible !important;
    margin-top: 24px !important;
    margin-bottom: 80px !important;
}

#satelliteCenter.workspace-intelligence-active
.satellite-grid {
    display: grid !important;
}

#satelliteCenter.workspace-intelligence-active
.satellite-center-header {
    display: flex !important;
}

#sentinel2Product {
    position: relative !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    overflow: visible !important;
}

.workspace-navigator {
    position: fixed !important;
    left: 50% !important;
    bottom: 24px !important;
    transform: translateX(-50%) !important;
    z-index: 99999 !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    gap: 10px !important;

    padding: 8px 10px !important;

    border-radius: 16px !important;
}

.workspace-nav-arrow {
    width: 46px !important;
    height: 46px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    cursor: pointer !important;

    font-size: 24px !important;
    line-height: 1 !important;
}

.workspace-nav-arrow:disabled {
    opacity: 0.35 !important;
    cursor: default !important;
}

.workspace-nav-divider {
    width: 1px !important;
    height: 28px !important;
}

/* ============================================================
   END FINAL WORKSPACE OVERRIDE
   ============================================================ */

/* ============================================================
   GEOSHIELD WORKSPACE FINAL LAYOUT
   Main Map = isolated full workspace
   Satellite Intelligence = isolated full workspace
   ============================================================ */

/* ---------- GLOBAL VIEWPORT CONTROL ---------- */

html,
body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow-x: hidden;
}

/* ---------- MAIN APPLICATION ---------- */

.main-content {
    display: grid;
    grid-template-rows: 60px minmax(0, 1fr) 88px;
    height: 100vh;
    min-height: 100vh;
    overflow: hidden;
}

/* ---------- MAIN MAP WORKSPACE ---------- */

.workspace {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 12px;

    width: 100%;
    min-width: 0;
    min-height: 0;

    box-sizing: border-box;
    padding: 8px;

    overflow: hidden;
}

/* Map takes the complete available map area */

.map-section {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;

    padding: 0;
    overflow: hidden;
}

/* Leaflet map */

#map {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;

    border-radius: 14px;
    overflow: hidden;
}

/* ---------- RIGHT INFORMATION PANEL ---------- */

.info-panel {
    width: 280px;
    min-width: 280px;
    max-width: 280px;

    box-sizing: border-box;

    background: #111827;
    border-left: 1px solid #263449;

    padding: 10px;

    overflow-y: auto;
    overflow-x: hidden;

    display: flex;
    flex-direction: column;
    gap: 10px;
}

/* Keep right-side cards compact */

.panel-card {
    width: 100%;
    min-height: 0;
    height: auto;

    box-sizing: border-box;

    background: #1f2937;
    border-radius: 12px;

    padding: 10px 12px;

    display: flex;
    flex-direction: column;
    justify-content: center;

    overflow: hidden;
    position: relative;

    box-shadow: 0 2px 6px rgba(0,0,0,.18);

    transition: .25s;
}

.panel-card h3 {
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 6px 0;

    display: flex;
    align-items: center;
    gap: 7px;
}

.panel-card p {
    font-size: 12px;
    color: #d1d5db;
    line-height: 1.4;
    margin: 0;
}

.panel-card h1 {
    font-size: 22px;
    font-weight: 700;
    margin: 2px 0 0 0;
}

/* ---------- BOTTOM DASHBOARD ---------- */

.bottom-dashboard {
    display: grid;

    grid-auto-flow: column;
    grid-auto-columns: minmax(130px, 150px);

    gap: 10px;

    width: 100%;
    min-width: 0;

    box-sizing: border-box;

    overflow-x: auto;
    overflow-y: hidden;

    padding: 8px 10px;

    background: #111827;
    border-top: 1px solid #263449;

    height: 88px;

    align-items: center;
}

/* Compact horizontal cards */

.bottom-card {
    width: 100%;
    height: 62px;

    box-sizing: border-box;

    background: #1f2937;
    border-radius: 12px;

    padding: 9px 10px;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    overflow: hidden;
}

.bottom-card h3,
.bottom-card h4,
.bottom-card p {
    margin: 0;
}

.bottom-card h3,
.bottom-card h4 {
    font-size: 13px;
}

.bottom-card p {
    font-size: 11px;
}

/* ============================================================
   SATELLITE INTELLIGENCE
   ============================================================ */

/*
   The older satelliteDataCenter duplicates the newer
   satelliteCenter. Hide only the obsolete duplicate.
*/

#satelliteDataCenter {
    display: none !important;
}

/*
   Satellite Intelligence becomes its own isolated workspace.
   It must never visually occupy the Main Map workspace.
*/

#satelliteCenter {
    width: 100%;
    min-height: 100vh;

    box-sizing: border-box;

    position: relative;

    padding: 40px 5vw 100px 5vw;

    background: #0b1220;

    overflow-x: hidden;
    overflow-y: auto;

    isolation: isolate;

    scroll-margin-top: 0;
}

/* Make the intelligence header readable */

#satelliteCenter .satellite-center-header {
    width: 100%;
    max-width: 1400px;

    margin: 0 auto 30px auto;
}

/* Larger intelligence typography */

#satelliteCenter h2 {
    font-size: 30px;
    line-height: 1.2;
}

#satelliteCenter p {
    font-size: 15px;
    line-height: 1.6;
}

/* Intelligence cards */

#satelliteCenter .satellite-grid {
    width: 100%;
    max-width: 1400px;

    margin: 0 auto;

    display: grid;

    grid-template-columns: repeat(
        auto-fit,
        minmax(260px, 1fr)
    );

    gap: 18px;

    align-items: stretch;
}

/* Sentinel-2 product belongs to the intelligence workspace */

#sentinel2Product {
    width: 100%;
    min-height: 70vh;

    box-sizing: border-box;

    padding: 40px 5vw 100px 5vw;

    background: #0b1220;

    overflow-x: hidden;
}

/* ============================================================
   WORKSPACE SEPARATION
   ============================================================ */

/*
   Ensure satellite content cannot visually leak into
   the Main Map viewport.
*/

.workspace,
.topbar,
.bottom-dashboard {
    position: relative;
    z-index: 2;
}

/*
   Satellite sections stay below the Main Map workspace.
*/

#satelliteCenter,
#sentinel2Product {
    position: relative;
    z-index: 1;
}

/* ============================================================
   NAVIGATION ARROWS
   Small, fixed, far-right controls
   ============================================================ */

.workspace-navigator {
    position: fixed !important;

    right: 16px !important;
    left: auto !important;

    bottom: 50% !important;

    transform: translateY(50%) !important;

    width: 38px !important;

    display: flex !important;
    flex-direction: column !important;

    align-items: center !important;
    justify-content: center !important;

    gap: 5px !important;

    padding: 5px !important;

    z-index: 99999 !important;

    background: rgba(15, 23, 42, .92) !important;

    border: 1px solid #334155 !important;

    border-radius: 12px !important;

    box-shadow: 0 8px 24px rgba(0,0,0,.35) !important;

    backdrop-filter: blur(8px);
}

.workspace-nav-arrow {
    width: 28px !important;
    height: 28px !important;

    min-width: 28px !important;
    min-height: 28px !important;

    padding: 0 !important;

    display: flex !important;

    align-items: center !important;
    justify-content: center !important;

    border: none !important;
    border-radius: 7px !important;

    background: #1e293b !important;
    color: white !important;

    font-size: 16px !important;

    cursor: pointer !important;
}

.workspace-nav-arrow:hover {
    background: #2563eb !important;
}

.workspace-nav-arrow:disabled {
    opacity: .35 !important;
    cursor: default !important;
}

.workspace-nav-divider {
    width: 18px !important;
    height: 1px !important;

    background: #475569 !important;

    margin: 1px 0 !important;
}

/* ============================================================
   RESPONSIVE FALLBACK
   ============================================================ */

@media (max-width: 900px) {

    .workspace {
        grid-template-columns: minmax(0, 1fr);
    }

    .info-panel {
        display: none;
    }

    .bottom-dashboard {
        grid-auto-columns: 130px;
    }

    #satelliteCenter {
        padding-left: 24px;
        padding-right: 24px;
    }

    #sentinel2Product {
        padding-left: 24px;
        padding-right: 24px;
    }

}


/* ============================================================
   GEOSHIELD FINAL MAP PANEL CORRECTION
   ============================================================ */

/* Main application keeps the original 3-row architecture */
.main-content {
    display: grid !important;

    grid-template-rows:
        60px
        minmax(0, 1fr)
        88px !important;

    height: 100vh !important;
    min-height: 100vh !important;

    overflow: hidden !important;
}

/* Main map area = ONLY the map + right information panel */
.workspace {
    display: grid !important;

    grid-template-columns:
        minmax(0, 1fr)
        280px !important;

    grid-template-rows: minmax(0, 1fr) !important;

    gap: 12px !important;

    width: 100% !important;
    height: 100% !important;

    min-width: 0 !important;
    min-height: 0 !important;

    box-sizing: border-box !important;

    padding: 8px !important;

    overflow: hidden !important;
}

/* Map stays entirely inside the left column */
.map-section {
    grid-column: 1 !important;
    grid-row: 1 !important;

    width: 100% !important;
    height: 100% !important;

    min-width: 0 !important;
    min-height: 0 !important;

    padding: 0 !important;

    overflow: hidden !important;
}

/* Map fills its column */
#map {
    width: 100% !important;
    height: 100% !important;

    min-width: 0 !important;
    min-height: 0 !important;

    border-radius: 14px !important;

    overflow: hidden !important;
}

/* Right information cards remain on the RIGHT */
.info-panel {
    grid-column: 2 !important;
    grid-row: 1 !important;

    width: 280px !important;
    min-width: 280px !important;
    max-width: 280px !important;

    height: 100% !important;

    box-sizing: border-box !important;

    display: flex !important;
    flex-direction: column !important;

    gap: 10px !important;

    padding: 10px !important;

    overflow-y: auto !important;
    overflow-x: hidden !important;

    background: #111827 !important;

    border-left: 1px solid #263449 !important;
}

/* Preserve sensible card sizes */
.info-panel .panel-card {
    flex: 0 0 auto !important;

    width: 100% !important;

    min-height: 78px !important;

    height: auto !important;

    box-sizing: border-box !important;

    padding: 12px 14px !important;

    overflow: hidden !important;
}

/* Bottom dashboard belongs ONLY to the bottom row */
.bottom-dashboard {
    grid-column: 1 / -1 !important;
    grid-row: 3 !important;

    display: grid !important;

    grid-auto-flow: column !important;
    grid-auto-columns: 150px !important;

    grid-template-rows: 1fr !important;

    gap: 10px !important;

    width: 100% !important;
    height: 88px !important;

    min-width: 0 !important;

    box-sizing: border-box !important;

    align-items: center !important;

    padding: 8px 10px !important;

    overflow-x: auto !important;
    overflow-y: hidden !important;

    background: #111827 !important;

    border-top: 1px solid #263449 !important;
}

/* Bottom cards stay compact and horizontal */
.bottom-dashboard .bottom-card {
    width: 150px !important;
    min-width: 150px !important;

    height: 62px !important;

    box-sizing: border-box !important;

    padding: 10px !important;

    overflow: hidden !important;
}

/* ============================================================
   SATELLITE INTELLIGENCE — SINGLE NAVIGATOR
   ============================================================ */

/* Never allow a second generated navigator */
.workspace-navigator + .workspace-navigator {
    display: none !important;
}

/* There must be exactly one visible workspace navigator */
.workspace-navigator {
    position: fixed !important;

    right: 14px !important;
    left: auto !important;

    top: 50% !important;
    bottom: auto !important;

    transform: translateY(-50%) !important;

    width: 38px !important;

    z-index: 999999 !important;

    display: flex !important;

    flex-direction: column !important;

    align-items: center !important;
    justify-content: center !important;

    gap: 5px !important;

    padding: 5px !important;

    box-sizing: border-box !important;

    background: rgba(15, 23, 42, .94) !important;

    border: 1px solid #334155 !important;

    border-radius: 10px !important;

    box-shadow: 0 8px 24px rgba(0,0,0,.35) !important;
}

.workspace-nav-arrow {
    width: 28px !important;
    height: 28px !important;

    min-width: 28px !important;
    min-height: 28px !important;

    padding: 0 !important;

    display: flex !important;

    align-items: center !important;
    justify-content: center !important;

    font-size: 16px !important;

    border-radius: 7px !important;

    background: #1e293b !important;

    color: white !important;

    border: none !important;
}

.workspace-nav-divider {
    width: 18px !important;
    height: 1px !important;

    margin: 1px 0 !important;

    background: #475569 !important;
}





/* Satellite Grid Native Horizontal Track & Capsule Scrollbar Styling */
#satelliteGrid {
    display: flex !important;
    flex-wrap: nowrap !important;
    overflow-x: auto !important;
    scroll-behavior: smooth !important;
    gap: 24px;
    padding-bottom: 12px;
    scrollbar-width: thin;
    scrollbar-color: #64748b #1e293b;
}

#satelliteGrid::-webkit-scrollbar {
    height: 8px;
}

#satelliteGrid::-webkit-scrollbar-track {
    background: #0f172a;
    border-radius: 4px;
}

#satelliteGrid::-webkit-scrollbar-thumb {
    background: #475569;
    border-radius: 4px;
}

#satelliteGrid::-webkit-scrollbar-thumb:hover {
    background: #64748b;
}

/* ==================== LIVE MAP PAGE ==================== */
.geoshield-livemap-page {
    display: none;
    flex-direction: column;
    height: 100%;
}
.geoshield-livemap-page.workspace-page-active {
    display: flex;
}
.livemap-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 20px;
    background: #0f172a;
    border-bottom: 1px solid #1e293b;
}
.livemap-controls {
    display: flex;
    align-items: center;
    gap: 16px;
}
.livemap-controls label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: #f8fafc;
    cursor: pointer;
}
.livemap-close-btn {
    background: #334155;
    color: #f8fafc;
    border: none;
    border-radius: 6px;
    width: 32px;
    height: 32px;
    font-size: 16px;
    cursor: pointer;
}
.livemap-close-btn:hover {
    background: #475569;
}
.livemap-container {
    flex: 1;
    width: 100%;
}


#liveMap { width: 100%; height: calc(100vh - 200px); min-height: 500px; border-radius: 8px; }
